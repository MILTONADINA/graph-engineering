import { createHash, randomBytes } from 'crypto';
import jwt from 'jsonwebtoken';
import { SECRETS } from './helpers';

export function generateAccessToken(userId: string, role: string): string {
  return jwt.sign({ sub: userId, role, type: 'access' }, SECRETS.ACCESS_TOKEN_SECRET, {
    expiresIn: '{{input.accessTokenTtl}}',
  });
}

export function generateRefreshToken(): { token: string; tokenHash: string; expiresAt: Date } {
  const token = randomBytes(32).toString('hex');
  const expiresAt = new Date(Date.now() + {{input.refreshTokenTtlDays}} * 24 * 60 * 60 * 1000);
  return { token, tokenHash: hashToken(token), expiresAt };
}

export function hashToken(token: string): string {
  return createHash('sha256').update(token).digest('hex');
}
