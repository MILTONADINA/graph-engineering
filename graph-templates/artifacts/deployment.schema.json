{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment.schema.json",
  "title": "Deployment Schema Artifact",
  "description": "Structured output of ai/devops-agent: container/CI configuration and required runtime environment.",
  "type": "object",
  "required": ["$schema", "artifactType", "version", "metadata", "data"],
  "properties": {
    "$schema": { "type": "string" },
    "artifactType": { "const": "deployment.schema" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "metadata": { "$ref": "requirements.schema.json#/$defs/metadata" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "requiredEnvVars"],
      "properties": {
        "target": { "enum": ["docker", "serverless", "vm"] },
        "dockerfile": { "type": "string" },
        "ciProvider": { "enum": ["github-actions", "none"] },
        "ciFile": { "type": "string" },
        "requiredEnvVars": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required", "secret"],
            "properties": {
              "name": { "type": "string" },
              "required": { "type": "boolean" },
              "secret": { "type": "boolean" },
              "description": { "type": "string" },
              "usedBy": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "healthCheckPath": { "type": "string", "default": "/" }
      }
    }
  }
}
