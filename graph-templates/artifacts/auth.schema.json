{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auth.schema.json",
  "title": "Auth Schema Artifact",
  "description": "Structured output of ai/authentication-agent: auth strategy, token shape, and protected-route conventions.",
  "type": "object",
  "required": ["$schema", "artifactType", "version", "metadata", "data"],
  "properties": {
    "$schema": { "type": "string" },
    "artifactType": { "const": "auth.schema" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "metadata": { "$ref": "requirements.schema.json#/$defs/metadata" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "tokenDelivery"],
      "properties": {
        "strategy": { "enum": ["jwt", "session", "oauth"] },
        "tokenDelivery": { "enum": ["httpOnlyCookie", "bearerHeader", "both"] },
        "accessTokenTtl": { "type": "string", "default": "15m" },
        "refreshTokenTtl": { "type": "string", "default": "30d" },
        "passwordHashing": { "enum": ["bcrypt", "argon2"], "default": "bcrypt" },
        "saltRounds": { "type": "integer", "default": 12 },
        "roles": { "type": "array", "items": { "type": "string" }, "default": ["customer", "admin"] },
        "oauthProviders": { "type": "array", "items": { "type": "string" } },
        "protectedRouteConvention": { "type": "string", "default": "authMiddleware sets req.user; authorization.rbac reads req.user.role" }
      }
    }
  }
}
