{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api.schema.json",
  "title": "API Schema Artifact",
  "description": "Structured output of ai/api-agent (or backend-agent): routes, request/response shapes, and their backing entities.",
  "type": "object",
  "required": ["$schema", "artifactType", "version", "metadata", "data"],
  "properties": {
    "$schema": { "type": "string" },
    "artifactType": { "const": "api.schema" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "metadata": { "$ref": "requirements.schema.json#/$defs/metadata" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basePath", "routes"],
      "properties": {
        "basePath": { "type": "string", "default": "/api" },
        "responseEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "success": { "type": "string", "default": "{ message, data }" },
            "error": { "type": "string", "default": "{ error: { message, status } }" }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["method", "path", "handler"],
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string" },
              "handler": { "type": "string", "description": "controller.method reference" },
              "entity": { "type": "string", "description": "database.schema table name this route operates on, if any" },
              "auth": { "enum": ["none", "required", "optional"], "default": "none" },
              "roles": { "type": "array", "items": { "type": "string" } },
              "pagination": { "type": "boolean" },
              "filtering": { "type": "array", "items": { "type": "string" }, "description": "Column names filterable via query params" },
              "sorting": { "type": "array", "items": { "type": "string" } },
              "requestSchema": { "type": "object", "description": "Zod-shape summary of expected request body" },
              "statusCodes": { "type": "array", "items": { "type": "integer" } }
            }
          }
        }
      }
    }
  }
}
