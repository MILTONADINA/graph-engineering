name: CI

on:
  pull_request:
    branches: [{{input.mainBranch}}]
  push:
    branches: [{{input.mainBranch}}]
  workflow_dispatch:

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "{{input.nodeVersion}}"
          cache: npm
      - run: npm ci
      - run: npm run build
      - run: npm test
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
          ACCESS_TOKEN_SECRET: ${{ secrets.ACCESS_TOKEN_SECRET }}

  # Manual-only: never runs on a plain push/PR. A human must trigger this
  # explicitly from the Actions tab so a schema change never rides along
  # with an unrelated merge.
  migrate-database:
    if: github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    needs: build-and-test
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: "{{input.nodeVersion}}"
          cache: npm
      - run: npm ci
      - run: npm run dbMigrate
        env:
          DATABASE_URL: ${{ secrets.DATABASE_URL }}
