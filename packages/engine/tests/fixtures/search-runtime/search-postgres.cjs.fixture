'use strict';
const assert = require('node:assert/strict');
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const ts = require('typescript');
const { Pool } = require('pg');

function run(command, args) {
  const result = spawnSync(command, args, { stdio: 'inherit', shell: false });
  if (result.status !== 0) throw new Error(`${command} failed (${result.status})`);
}

async function main() {
  const data = fs.mkdtempSync('/tmp/graph-search-db-');
  run('initdb', ['-D', data, '-U', 'graph_test', '--auth=trust', '--no-locale']);
  run('pg_ctl', ['-D', data, '-o', '-h 127.0.0.1 -p 54331 -k /tmp', '-w', 'start']);
  try {
    run('createdb', ['-h', '127.0.0.1', '-p', '54331', '-U', 'graph_test', 'graph_search_test']);
    run(process.execPath, ['node_modules/drizzle-kit/bin.cjs', 'generate', '--name=search-index']);
    const migration = fs.readdirSync('src/migrations').filter(name => /^\d+_.*\.sql$/.test(name));
    assert.equal(migration.length, 1);
    const migrationPath = path.join('src/migrations', migration[0]);
    const ddl = fs.readFileSync(migrationPath, 'utf8');
    assert.match(ddl, /CREATE INDEX "products_search_fts_idx" ON "products" USING gin/);
    assert.match(ddl, /to_tsvector\('english'/);
    run('psql', ['-h', '127.0.0.1', '-p', '54331', '-U', 'graph_test', '-d', 'graph_search_test', '-v', 'ON_ERROR_STOP=1', '-f', migrationPath]);

    const pool = new Pool({ connectionString: 'postgresql://graph_test@127.0.0.1:54331/graph_search_test' });
    try {
      const index = await pool.query("SELECT indexdef FROM pg_indexes WHERE tablename = 'products' AND indexname = 'products_search_fts_idx'");
      assert.equal(index.rowCount, 1);
      assert.match(index.rows[0].indexdef, /USING gin \(to_tsvector/);
      await pool.query(`INSERT INTO products (id, name, description, quantity) VALUES
        ('11111111-1111-4111-8111-111111111111', 'graph engine', 'ranked text', 1),
        ('22222222-2222-4222-8222-222222222222', 'database tooling', 'graph engineering text', 2),
        ('33333333-3333-4333-8333-333333333333', 'unrelated', 'nothing', 3)`);

      const source = fs.readFileSync('src/search/productSearch.ts', 'utf8');
      const compiled = ts.transpileModule(source, {
        compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
      }).outputText;
      const module = { exports: {} };
      const requireGenerated = name => {
        if (name === '../config/database') return { pool };
        throw new Error(`Unexpected generated import: ${name}`);
      };
      new Function('require', 'module', 'exports', 'Buffer', compiled)(requireGenerated, module, module.exports, Buffer);
      const search = module.exports.searchProduct;
      for (const invalid of [{ q: 'x' }, { q: ['graph'] }, { q: 'graph', page: 1001 }])
        await assert.rejects(() => search(invalid), { name: 'Error', message: 'Invalid search query' });
      const first = await search({ q: 'graph', page: 1, pageSize: 1 });
      const second = await search({ q: 'graph', page: 2, pageSize: 1 });
      const empty = await search({ q: 'graph', page: 3, pageSize: 1 });
      const injection = await search({ q: "graph' OR 1=1", page: 1, pageSize: 10 });
      assert.equal(first.pagination.total, 2);
      assert.equal(second.pagination.total, 2);
      assert.equal(empty.pagination.total, 2);
      assert.equal(first.data.length, 1);
      assert.equal(second.data.length, 1);
      assert.equal(empty.data.length, 0);
      assert.deepEqual(injection, { data: [], pagination: { page: 1, pageSize: 10, total: 0 } });
      assert.notEqual(first.data[0].id, second.data[0].id);
      assert.ok(first.data[0].rank >= second.data[0].rank);

      const query = source.match(/const SQL = String\.raw`([\s\S]*?)`;/)?.[1];
      assert.ok(query);
      const client = await pool.connect();
      try {
        await client.query('SET enable_seqscan = off');
        const explain = await client.query(`EXPLAIN ${query}`, ['graph', 20, 0]);
        assert.match(explain.rows.map(row => row['QUERY PLAN']).join('\n'), /products_search_fts_idx/);
      } finally {
        client.release();
      }
      console.log('search index and ranked pagination passed on isolated PostgreSQL');
    } finally {
      await pool.end();
    }
  } finally {
    run('pg_ctl', ['-D', data, '-m', 'immediate', '-w', 'stop']);
  }
}
main().catch(error => { console.error(error); process.exitCode = 1; });
