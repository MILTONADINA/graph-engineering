import { beforeEach, describe, expect, it, vi } from "vitest";
import request from "supertest";
const state = vi.hoisted(() => ({
  identity: null as any,
  results: [] as any[][],
  selected: [] as any[],
  where: [] as { sql: string; params: unknown[] }[],
  values: [] as any[],
  transactions: 0,
  locks: [] as { sql: string; params: unknown[] }[],
  delivered: [] as any[],
}));
vi.mock("../src/config/database", async () => {
  const { PgDialect } = await vi.importActual<
    typeof import("drizzle-orm/pg-core")
  >("drizzle-orm/pg-core");
  const chain = () => {
    const query: any = {
      from: () => query,
      innerJoin: () => query,
      set: () => query,
      where: (condition: any) => {
        state.where.push(new PgDialect().sqlToQuery(condition));
        return query;
      },
      values: (value: unknown) => {
        state.values.push(value);
        return query;
      },
      returning: () => Promise.resolve(state.results.shift() ?? []),
      limit: () => Promise.resolve(state.selected),
      then: (resolve: any, reject: any) =>
        Promise.resolve([]).then(resolve, reject),
    };
    return query;
  };
  const database: any = {
    execute: async (query: any) => {
      const { sql, params } = new PgDialect().sqlToQuery(query);
      state.locks.push({ sql, params });
    },
    select: () => chain(),
    insert: () => chain(),
    update: () => chain(),
    transaction: async (fn: any) => {
      state.transactions++;
      return fn(database);
    },
  };
  return { database };
});
vi.mock("../src/services/authIdentity", () => ({
  resolveAuthenticationIdentity: async () => state.identity,
}));
vi.mock("../src/services/authenticationDelivery", () => ({
  deliverAuthenticationToken: async (message: unknown) => {
    state.delivered.push(message);
  },
}));
import app from "../src/app";
import { SECRETS } from "../src/utils/helpers";
import {
  generateAccessToken,
  verifyAccessToken,
  hashToken,
} from "../src/utils/tokens";
import { authMiddleware } from "../src/middlewares/authMiddleware";
import { AuthenticationRepository } from "../src/repository/Authentication";
import { AuthenticationService } from "../src/services/authenticationService";
const id = "11111111-1111-4111-8111-111111111111",
  token = "ab".repeat(32);
const identity = {
  id,
  email: "fixture@example.invalid",
  role: "admin" as const,
  status: "active" as const,
};
const user = {
  ...identity,
  passwordHash: "unavailable",
  emailVerifiedAt: new Date(),
  createdAt: new Date(),
  updatedAt: new Date(),
  profile: {
    userId: id,
    firstName: "Fixture",
    lastName: "User",
    phone: null,
    avatarUrl: null,
    createdAt: new Date(),
    updatedAt: new Date(),
  },
};
beforeEach(() => {
  vi.restoreAllMocks();
  state.identity = { ...identity };
  state.results = [];
  state.selected = [];
  state.where = [];
  state.values = [];
  state.transactions = 0;
  state.locks = [];
  state.delivered = [];
});
describe("actual generated authentication security boundaries", () => {
  it("allows idempotent cookie clearing without live access credentials but still requires a trusted origin", async () => {
    const denied = await request(app)
      .post("/api/auth/logout")
      .set("Origin", "https://untrusted.example");
    expect(denied.status).toBe(403);
    expect(denied.headers["set-cookie"]).toBeUndefined();
    for (const token of [undefined, "malformed"]) {
      let operation = request(app)
        .post("/api/auth/logout")
        .set("Origin", SECRETS.CORS_ORIGIN);
      if (token)
        operation = operation.set(
          "Cookie",
          "refresh_token=" + token + "; access_token=expired",
        );
      const response = await operation;
      expect(response.status).toBe(200);
      expect(response.body).toEqual({ message: "Logged out", data: null });
      const cookies = response.headers["set-cookie"] as unknown as string[];
      expect(cookies).toHaveLength(2);
      expect(
        cookies.every(
          (cookie) =>
            /^(?:access|refresh)_token=;/.test(cookie) &&
            cookie.includes("HttpOnly") &&
            cookie.includes("SameSite=Strict") &&
            cookie.includes("Expires=Thu, 01 Jan 1970"),
        ),
      ).toBe(true);
    }
    expect(state.transactions).toBe(0);
  });
  it("resolves live account roles and rejects suspended identities instead of trusting stale JWT roles", async () => {
    state.identity = { ...identity, role: "customer" };
    const req: any = {
        headers: {
          authorization: "Bearer " + generateAccessToken(id, "admin"),
        },
        method: "GET",
        user: { role: "admin" },
      },
      res: any = { status: vi.fn().mockReturnThis(), json: vi.fn() },
      next = vi.fn();
    await authMiddleware(req, res, next);
    expect(req.user.role).toBe("customer");
    expect(next).toHaveBeenCalledWith();
    state.identity.status = "suspended";
    next.mockClear();
    await authMiddleware(req, res, next);
    expect(next).toHaveBeenCalledExactlyOnceWith(
      expect.objectContaining({ status: 401 }),
    );
    expect(res.status).not.toHaveBeenCalled();
    expect(req.user).toBeUndefined();
  });
  it("requires trusted origins for cookie writes and does not fall back from malformed authorization headers", async () => {
    const res: any = { status: vi.fn().mockReturnThis(), json: vi.fn() },
      next = vi.fn(),
      cookie = generateAccessToken(id, "admin");
    await authMiddleware(
      { headers: {}, method: "POST", cookies: { access_token: cookie } } as any,
      res,
      next,
    );
    expect(next).toHaveBeenCalledExactlyOnceWith(
      expect.objectContaining({ status: 403 }),
    );
    expect(res.status).not.toHaveBeenCalled();
    next.mockClear();
    await authMiddleware(
      {
        headers: { authorization: "Basic invalid" },
        method: "GET",
        cookies: { access_token: cookie },
      } as any,
      res,
      next,
    );
    expect(next).toHaveBeenCalledExactlyOnceWith(
      expect.objectContaining({ status: 401 }),
    );
    expect(res.status).not.toHaveBeenCalled();
  });
  it("consumes refresh credentials with atomic expiry/revocation predicates and preserves the current role", async () => {
    state.selected = [{ userId: id }];
    state.results = [
      [
        {
          id,
          userId: id,
          expiresAt: new Date(Date.now() + 60000),
          revokedAt: null,
          tokenHash: hashToken(token),
        },
      ],
    ];
    const response = await request(app)
      .post("/api/auth/refresh")
      .set("Origin", SECRETS.CORS_ORIGIN)
      .set("Cookie", "refresh_token=" + token);
    expect(response.status).toBe(200);
    expect(state.transactions).toBe(1);
    expect(state.where[1].sql).toContain('"revoked_at" is null');
    expect(state.where[1].sql).toContain('"expires_at" >');
    expect(state.where[1].params).toContain(hashToken(token));
    expect(state.where[1].params).not.toContain(token);
    expect(state.locks).toEqual([
      {
        sql: "SELECT pg_advisory_xact_lock(hashtextextended($1, 0))",
        params: ["graph-auth:" + id],
      },
    ]);
    expect(state.values).toHaveLength(1);
    expect(state.values[0]).not.toHaveProperty("token");
    const access = (response.headers["set-cookie"] as unknown as string[])
      .find((value) => value.startsWith("access_token="))!
      .split(";")[0]
      .slice("access_token=".length);
    expect(verifyAccessToken(decodeURIComponent(access))?.role).toBe("admin");
    expect(response.body).toEqual({ message: "Token refreshed", data: null });
  });
  it("rejects consumed/expired refresh tokens and invalid account state without issuing replacements", async () => {
    state.results = [[]];
    state.selected = [
      {
        userId: id,
        revokedAt: new Date(),
        expiresAt: new Date(Date.now() + 60000),
      },
    ];
    const replay = await request(app)
      .post("/api/auth/refresh")
      .set("Origin", SECRETS.CORS_ORIGIN)
      .set("Cookie", "refresh_token=" + token);
    expect(replay.status).toBe(401);
    expect(state.values).toEqual([]);
    expect(state.where.at(-1)?.params).toEqual([id]);
    state.results = [[{ id, userId: id }]];
    state.identity.status = "suspended";
    expect(
      (
        await request(app)
          .post("/api/auth/refresh")
          .set("Origin", SECRETS.CORS_ORIGIN)
          .set("Cookie", "refresh_token=" + token)
      ).status,
    ).toBe(401);
    expect(state.values).toEqual([]);
  });
  it("consumes password reset tokens and changes credentials/revokes refresh tokens in one transaction", async () => {
    state.selected = [{ userId: id }];
    state.results = [[{ userId: id }], [{ id }]];
    expect(
      await new AuthenticationRepository().consumeActionToken(
        token,
        "password_reset",
        "prepared-hash",
      ),
    ).toBe(id);
    expect(state.transactions).toBe(1);
    expect(state.where).toHaveLength(4);
    expect(state.where[1].sql).toContain('"consumed_at" is null');
    expect(state.where[1].sql).toContain('"expires_at" >');
    expect(state.where[1].params).toContain("password_reset");
    expect(state.where[1].params).not.toContain(token);
    expect(state.where[3].params).toEqual([id]);
    expect(state.locks).toEqual([
      {
        sql: "SELECT pg_advisory_xact_lock(hashtextextended($1, 0))",
        params: ["graph-auth:" + id],
      },
    ]);
  });
  it("rejects used action tokens before user mutation and enforces reset password policy first", async () => {
    state.results = [[]];
    expect(
      await new AuthenticationRepository().consumeActionToken(
        token,
        "email_verification",
      ),
    ).toBeNull();
    expect(state.where).toHaveLength(1);
    const consume = vi.spyOn(
      AuthenticationRepository.prototype,
      "consumeActionToken",
    );
    await expect(
      new AuthenticationService().resetPassword(token, "short", "short"),
    ).rejects.toMatchObject({ status: 400 });
    expect(consume).not.toHaveBeenCalled();
  });
  it("performs a password hash comparison even for an unknown login identity", async () => {
    vi.spyOn(
      AuthenticationRepository.prototype,
      "findUserByEmail",
    ).mockResolvedValue(undefined);
    const compare = vi
      .spyOn(AuthenticationRepository.prototype, "comparePasswords")
      .mockResolvedValue(false);
    await expect(
      new AuthenticationService().login(
        "missing@example.invalid",
        "fixture-password-value",
      ),
    ).rejects.toMatchObject({ status: 401 });
    expect(compare).toHaveBeenCalledOnce();
    expect(compare.mock.calls[0][1]).toMatch(/^\$2[ab]\$/);
  });
  it("delivers registration tokens only to the adapter, never API responses or client-controlled host links", async () => {
    vi.spyOn(
      AuthenticationRepository.prototype,
      "validateRegistration",
    ).mockResolvedValue();
    vi.spyOn(
      AuthenticationRepository.prototype,
      "createUser",
    ).mockResolvedValue(user as any);
    vi.spyOn(
      AuthenticationRepository.prototype,
      "generateEmailVerificationToken",
    ).mockResolvedValue({ token, expiresAt: new Date(Date.now() + 60000) });
    vi.spyOn(
      AuthenticationRepository.prototype,
      "findUserById",
    ).mockResolvedValue(user as any);
    const response = await request(app)
      .post("/api/auth/register")
      .set("Origin", SECRETS.CORS_ORIGIN)
      .set("Host", "attacker.invalid")
      .send({
        firstName: "Fixture",
        lastName: "User",
        email: user.email,
        password: "fixture-password-value",
      });
    expect(response.status).toBe(201);
    expect(JSON.stringify(response.body)).not.toContain(token);
    expect(response.body.data.user).not.toHaveProperty("passwordHash");
    expect(response.body.data).not.toHaveProperty("verificationLink");
    expect(state.delivered[0]).toMatchObject({
      email: user.email,
      kind: "email_verification",
      token,
    });
  });
  it("keeps forgot-password responses identical and rejects role mass assignment", async () => {
    vi.spyOn(AuthenticationRepository.prototype, "findUserByEmail")
      .mockResolvedValueOnce(user as any)
      .mockResolvedValueOnce(undefined);
    vi.spyOn(
      AuthenticationRepository.prototype,
      "generatePasswordResetToken",
    ).mockResolvedValue({ token, expiresAt: new Date(Date.now() + 60000) });
    const first = await request(app)
      .post("/api/auth/forgot-password")
      .set("Origin", SECRETS.CORS_ORIGIN)
      .send({ email: user.email });
    const second = await request(app)
      .post("/api/auth/forgot-password")
      .set("Origin", SECRETS.CORS_ORIGIN)
      .send({ email: "missing@example.invalid" });
    expect(first.status).toBe(200);
    expect(second.status).toBe(200);
    expect(first.body).toEqual(second.body);
    expect(
      (
        await request(app)
          .post("/api/auth/register")
          .set("Origin", SECRETS.CORS_ORIGIN)
          .send({
            firstName: "Fixture",
            lastName: "User",
            email: user.email,
            password: "fixture-password-value",
            role: "admin",
          })
      ).status,
    ).toBe(400);
  });
});
