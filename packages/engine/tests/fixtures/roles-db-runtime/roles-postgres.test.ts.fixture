import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
import request from "supertest";
import { eq } from "drizzle-orm";
import app from "../src/app";
import { database, pool } from "../src/config/database";
import {
  roleAuditLogTable,
  roleTable,
  userProfileTable,
  userTable,
} from "../src/config/schema";
import { roleRepository } from "../src/repository/Roles";
import {
  assignRole,
  bootstrapInitialAdmin,
  createRole,
  deleteRole,
  grantPermission,
  hasPermission,
  revokeRole,
  rolesForUser,
} from "../src/services/roleService";
import { generateAccessToken } from "../src/utils/tokens";

const first = "11111111-1111-4111-8111-111111111111";
const second = "22222222-2222-4222-8222-222222222222";
const member = "33333333-3333-4333-8333-333333333333";
const status = (promise: Promise<unknown>) =>
  promise.then(
    () => 0,
    (error) => error.status,
  );

beforeAll(async () => {
  if (
    process.env.DATABASE_URL !==
    "postgresql://graph_test@127.0.0.1:54329/graph_roles_test"
  )
    throw new Error("Only the disposable isolated roles test database is allowed");
  await pool.query(
    "CREATE TYPE user_role AS ENUM ('customer','admin'); CREATE TYPE user_status AS ENUM ('active','suspended');",
  );
  await pool.query(
    "CREATE TABLE users (id uuid PRIMARY KEY DEFAULT gen_random_uuid(),email varchar(320) UNIQUE NOT NULL,password_hash varchar(255) NOT NULL,role user_role NOT NULL DEFAULT 'customer',status user_status NOT NULL DEFAULT 'active',email_verified_at timestamptz,created_at timestamptz NOT NULL DEFAULT now(),updated_at timestamptz NOT NULL DEFAULT now());",
  );
  await pool.query(
    "CREATE TABLE user_profiles (user_id uuid PRIMARY KEY REFERENCES users(id),first_name varchar(100) NOT NULL,last_name varchar(100) NOT NULL,phone varchar(32),avatar_url varchar(2048),created_at timestamptz NOT NULL DEFAULT now(),updated_at timestamptz NOT NULL DEFAULT now());",
  );
  await pool.query(
    "CREATE TABLE roles (id uuid PRIMARY KEY DEFAULT gen_random_uuid(),name varchar(32) NOT NULL,built_in boolean NOT NULL DEFAULT false,created_at timestamptz NOT NULL DEFAULT now(),updated_at timestamptz NOT NULL DEFAULT now()); CREATE UNIQUE INDEX roles_name_idx ON roles (name);",
  );
  await pool.query(
    "CREATE TABLE user_roles (id uuid PRIMARY KEY DEFAULT gen_random_uuid(),user_id uuid NOT NULL,role_id uuid NOT NULL REFERENCES roles(id) ON DELETE CASCADE,created_at timestamptz NOT NULL DEFAULT now()); CREATE UNIQUE INDEX user_roles_user_role_idx ON user_roles (user_id, role_id);",
  );
  await pool.query(
    "CREATE TABLE role_permissions (id uuid PRIMARY KEY DEFAULT gen_random_uuid(),role_id uuid NOT NULL REFERENCES roles(id) ON DELETE CASCADE,permission varchar(65) NOT NULL,created_at timestamptz NOT NULL DEFAULT now()); CREATE UNIQUE INDEX role_permissions_role_permission_idx ON role_permissions (role_id, permission);",
  );
  await pool.query(
    "CREATE TABLE role_audit_log (id uuid PRIMARY KEY DEFAULT gen_random_uuid(),occurred_at timestamptz NOT NULL DEFAULT now(),actor_id uuid,action varchar(32) NOT NULL,target varchar(64),detail varchar(65),outcome varchar(16) NOT NULL,status integer);",
  );
});
afterAll(() => pool.end());
beforeEach(async () => {
  vi.spyOn(console, "info").mockImplementation(() => undefined);
  vi.spyOn(console, "error").mockImplementation(() => undefined);
  vi.spyOn(console, "warn").mockImplementation(() => undefined);
  await pool.query("TRUNCATE users, user_profiles, roles, user_roles, role_permissions, role_audit_log CASCADE");
  // Every fixture user carries the legacy users.role = 'admin' claim; it must never grant access.
  for (const [index, id] of [first, second, member].entries())
    await database.insert(userTable).values({
      id,
      email: `user${index}@example.invalid`,
      passwordHash: "not-a-real-hash",
      role: "admin",
      status: "active",
      emailVerifiedAt: new Date(),
    });
  for (const id of [first, second, member])
    await database
      .insert(userProfileTable)
      .values({ userId: id, firstName: "Fixture", lastName: "User" });
  await bootstrapInitialAdmin(first);
});

describe("authorization.roles against PostgreSQL", () => {
  it("serializes concurrent revocations so one administrator always remains", async () => {
    await assignRole(first, second, "admin");
    const results = await Promise.all([
      status(revokeRole(first, second, "admin")),
      status(revokeRole(second, first, "admin")),
    ]);
    expect(results.sort()).toEqual([0, 403]);
    const remaining = await pool.query(
      "SELECT count(*)::int AS value FROM user_roles ur JOIN roles r ON r.id = ur.role_id WHERE r.name = 'admin'",
    );
    expect(remaining.rows[0].value).toBe(1);
    const survivor = (await rolesForUser(first)).has("admin") ? first : second;
    expect(await status(revokeRole(survivor, survivor, "admin"))).toBe(409);
  });

  it("refuses to revoke the only active administrator while another holder is suspended", async () => {
    await assignRole(first, second, "admin");
    await database
      .update(userTable)
      .set({ status: "suspended" })
      .where(eq(userTable.id, second));
    expect(await status(revokeRole(first, first, "admin"))).toBe(409);
    expect((await rolesForUser(first)).has("admin")).toBe(true);
    await revokeRole(first, second, "admin");
    await database
      .update(userTable)
      .set({ status: "suspended" })
      .where(eq(userTable.id, first));
    expect(await status(bootstrapInitialAdmin(member))).toBe(0);
    expect((await rolesForUser(member)).has("admin")).toBe(true);
  });

  it("keeps built-in rows in SQL and cascades deleted roles out of assignments and grants", async () => {
    const [admin] = await database.select().from(roleTable);
    expect(admin).toMatchObject({ name: "admin", builtIn: true });
    expect(await roleRepository.deleteRole(database, admin.id)).toBe(false);
    expect(await roleRepository.renameRole(database, admin.id, "owner")).toBeNull();
    await createRole(first, "support");
    await assignRole(first, member, "support");
    await grantPermission(first, "support", "tickets:close");
    expect(await hasPermission(member, "tickets:close")).toBe(true);
    await deleteRole(first, "support");
    expect([...(await rolesForUser(member))]).toEqual([]);
    expect(await hasPermission(member, "tickets:close")).toBe(false);
    expect(await status(bootstrapInitialAdmin(member))).toBe(409);
  });

  it("authorizes HTTP management from database assignments, not the token role claim", async () => {
    const token = (id: string) => `Bearer ${generateAccessToken(id, "admin")}`;
    const denied = await request(app)
      .post("/api/roles")
      .set("authorization", token(member))
      .send({ name: "support" });
    const probing = await request(app)
      .delete("/api/roles/does-not-exist")
      .set("authorization", token(member));
    expect([denied.status, probing.status]).toEqual([403, 403]);
    expect(denied.body).toEqual(probing.body);
    const created = await request(app)
      .post("/api/roles")
      .set("authorization", token(first))
      .send({ name: "support" });
    expect(created.status).toBe(201);
    const assigned = await request(app)
      .put(`/api/roles/admin/users/${member}`)
      .set("authorization", token(first));
    expect(assigned.status).toBe(204);
    const allowed = await request(app)
      .get("/api/roles")
      .set("authorization", token(member));
    expect(allowed.status).toBe(200);
    expect(allowed.body.data.map((role: { name: string }) => role.name)).toEqual([
      "admin",
      "support",
    ]);
    await request(app)
      .delete(`/api/roles/admin/users/${member}`)
      .set("authorization", token(first))
      .expect(204);
    const revoked = await request(app)
      .get("/api/roles")
      .set("authorization", token(member));
    expect(revoked.status).toBe(403);
  });

  const token = (id: string) => `Bearer ${generateAccessToken(id, "admin")}`;
  const rows = () =>
    database
      .select({
        actorId: roleAuditLogTable.actorId,
        action: roleAuditLogTable.action,
        target: roleAuditLogTable.target,
        detail: roleAuditLogTable.detail,
        outcome: roleAuditLogTable.outcome,
        status: roleAuditLogTable.status,
      })
      .from(roleAuditLogTable);

  it("stores audit rows with committed changes only, with the role, permission or new name as detail", async () => {
    expect(await rows()).toEqual([
      { actorId: null, action: "admin.bootstrap", target: first, detail: "admin", outcome: "succeeded", status: null },
    ]);
    await pool.query("TRUNCATE role_audit_log");
    await request(app).post("/api/roles").set("authorization", token(first)).send({ name: "support" }).expect(201);
    await request(app).put(`/api/roles/support/users/${member}`).set("authorization", token(first)).expect(204);
    await request(app).put("/api/roles/support/permissions/tickets:close").set("authorization", token(first)).expect(204);
    await request(app).patch("/api/roles/support").set("authorization", token(first)).send({ name: "helpdesk" }).expect(200);
    expect(await rows()).toEqual(
      expect.arrayContaining([
        { actorId: first, action: "role.create", target: "support", detail: null, outcome: "succeeded", status: null },
        { actorId: first, action: "role.assign", target: member, detail: "support", outcome: "succeeded", status: null },
        { actorId: first, action: "permission.grant", target: "support", detail: "tickets:close", outcome: "succeeded", status: null },
        { actorId: first, action: "role.rename", target: "support", detail: "helpdesk", outcome: "succeeded", status: null },
      ]),
    );
    expect(await rows()).toHaveLength(4);
    await pool.query("TRUNCATE role_audit_log");
    // The last-admin refusal rolls back: no success row, one failed row written outside it.
    const refused = await request(app).delete(`/api/roles/admin/users/${first}`).set("authorization", token(first));
    expect(refused.status).toBe(409);
    expect((await rolesForUser(first)).has("admin")).toBe(true);
    expect(await rows()).toEqual([
      { actorId: first, action: "role.revoke", target: first, detail: "admin", outcome: "failed", status: 409 },
    ]);
    // A success row is part of its transaction: if the change aborts after the row is written, both go.
    await expect(
      database.transaction(async (tx) => {
        await roleRepository.insertAuditEntry(tx, {
          actorId: first, action: "role.create", target: "ghost", detail: null, outcome: "succeeded", status: null,
        });
        throw new Error("abort");
      }),
    ).rejects.toThrow("abort");
    expect((await rows()).filter((row) => row.outcome === "succeeded")).toEqual([]);
  });

  it("stores nothing for an anonymous flood and one denial per actor, action and minute", async () => {
    await pool.query("TRUNCATE role_audit_log");
    const requests = [];
    for (let index = 0; index < 40; index += 1)
      requests.push(
        request(app).get("/api/roles/audit"),
        request(app).delete("/api/roles/admin").set("authorization", "Bearer not-a-token"),
        request(app).post("/api/roles").set("authorization", `Bearer ${"x".repeat(index + 1)}`).send({ name: "flood" }),
      );
    for (const response of await Promise.all(requests)) expect(response.status).toBe(401);
    expect(await rows()).toEqual([]);
    // Start from a clean limiter window regardless of earlier tests in this file.
    vi.useFakeTimers({ toFake: ["Date"] });
    try {
      vi.setSystemTime(Date.now() + 10 * 60 * 1000);
      for (let index = 0; index < 25; index += 1)
        expect((await request(app).delete("/api/roles/admin").set("authorization", token(member))).status).toBe(403);
      await request(app).get("/api/roles/audit").set("authorization", token(member)).expect(403);
      expect(await rows()).toEqual([
        { actorId: member, action: "role.delete", target: "admin", detail: null, outcome: "denied", status: 403 },
        { actorId: member, action: "audit.read", target: null, detail: null, outcome: "denied", status: 403 },
      ]);
      vi.setSystemTime(Date.now() + 61 * 1000);
      await request(app).delete("/api/roles/admin").set("authorization", token(member)).expect(403);
      expect((await rows()).filter((row) => row.action === "role.delete")).toHaveLength(2);
    } finally {
      vi.useRealTimers();
    }
  });

  it("serves the log to administrators only, with before-cursor paging and strict filters", async () => {
    // A non-administrator whose token claims admin cannot read the log.
    const denied = await request(app).get("/api/roles/audit").set("authorization", token(member));
    expect(denied.status).toBe(403);
    expect(denied.body).toEqual({ error: { message: "Forbidden", status: 403 } });
    expect((await request(app).get("/api/roles/audit")).status).toBe(401);
    for (const name of ["one", "two", "three", "four", "five"])
      await request(app).post("/api/roles").set("authorization", token(first)).send({ name }).expect(201);
    const page = (query: string) => request(app).get(`/api/roles/audit?${query}`).set("authorization", token(first));
    const firstPage = await page("limit=2&outcome=succeeded&action=role.create");
    expect(firstPage.status).toBe(200);
    expect(firstPage.body.data.map((row: { target: string }) => row.target)).toEqual(["five", "four"]);
    for (const row of firstPage.body.data)
      expect(Object.keys(row).sort()).toEqual(["action", "actorId", "detail", "id", "occurredAt", "outcome", "status", "target"]);
    const secondPage = await page(`limit=2&outcome=succeeded&action=role.create&before=${firstPage.body.data[1].id}`);
    expect(secondPage.body.data.map((row: { target: string }) => row.target)).toEqual(["three", "two"]);
    const lastPage = await page(`limit=2&outcome=succeeded&action=role.create&before=${secondPage.body.data[1].id}`);
    expect(lastPage.body.data.map((row: { target: string }) => row.target)).toEqual(["one"]);
    await request(app).post("/api/roles").set("authorization", token(first)).send({ name: "one" }).expect(409);
    const failedOnly = await page("outcome=failed");
    expect(
      failedOnly.body.data.map((row: { actorId: string; action: string; target: string; status: number }) => [
        row.actorId, row.action, row.target, row.status,
      ]),
    ).toEqual([[first, "role.create", null, 409]]);
    for (const query of ["limit=201", "before=not-a-uuid", "outcome=ok", "action=role.drop", "action=role.create&action=role.delete", "sort=asc"])
      expect((await page(query)).status).toBe(400);
    expect((await page("before=44444444-4444-4444-8444-444444444444")).body).toEqual({ data: [] });
  });
});
