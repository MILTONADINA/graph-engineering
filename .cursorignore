# Defense in depth for Cursor's own indexing and Agent file context.
# The project MCP has a separate export policy; this file does not constrain
# Cursor's terminal, MCP tools, or files deliberately pasted into a prompt.
/.graph/
**/.graph/local/
**/.graph/workspaces/
**/.graph/cache/
**/.graph/knowledge/
**/.graph/project.json
**/.graph/providers.json
**/.graph/decisions.json
.serena/
.claude/
.codex/
**/private-memory/
**/.ssh/
**/.aws/
**/.gnupg/
**/.cursor/mcp.json
.mcp.json
**/.env
**/.env.*
# Only these reviewed, tracked public placeholders are safe to re-include.
# Never put live values in them; local values belong in excluded .env files.
!graph-templates/devops/environments/files/.env.example.reference-stack.template
!graph-templates/examples/express-neon-s3-app/.env.example
!graph-templates/examples/multi-tenant-saas/.env.example
!graph-templates/project/nextjs/files/.env.example.template
!graph-templates/project/node-express/files/.env.example.template
!graph-templates/project/vite-react/files/.env.example.template
**/.npmrc
**/.pypirc
**/.netrc
**/credentials.json
**/secrets.json
**/credentials
**/credentials.*
**/secrets
**/secrets.*
**/tokens.json
**/jevkey
**/jevkey.*
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/*.sqlite
**/*.sqlite-*
