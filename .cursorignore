# Defense in depth for Cursor's own indexing and Agent file context.
# The project MCP has a separate export policy; this file does not constrain
# Cursor's terminal, MCP tools, or files deliberately pasted into a prompt.
/.graph/
**/.graph/local/
**/.graph/workspaces/
**/.graph/cache/
**/.graph/knowledge/
**/.graph/project.json
**/.graph/providers.json
**/.graph/decisions.json
.serena/
.claude/
.codex/
**/private-memory/
**/.ssh/
**/.aws/
**/.gnupg/
**/.cursor/mcp.json
.mcp.json
**/.env
**/.env.*
**/.npmrc
**/.pypirc
**/.netrc
**/credentials.json
**/secrets.json
**/credentials
**/credentials.*
**/secrets
**/secrets.*
**/tokens.json
**/jevkey
**/jevkey.*
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/private/
**/.private/
**/backups/
