FROM node@sha256:40ad9f3064e67d6860b4bc3fe1880b2953934fd6320ada990e45fe0efa6badd7
WORKDIR /opt/sealed-oracle
COPY evaluation/guest-runtime/package.json evaluation/guest-runtime/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY evaluation/sealed/oracle-runtime/engineering-executor.mjs ./
COPY evaluation/sealed/oracle-runtime/module-graph-executor.mjs ./
USER 65534:65534
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/node", "--max-old-space-size=96", "/opt/sealed-oracle/engineering-executor.mjs"]
